NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=universal_backend
DB_USER=postgres
DB_PASSWORD=change_me
DB_SSL=false
DB_LOGGING=false

# Generate a private random value of at least 32 bytes; never commit production secrets.
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY=false
# Defaults to disabled in production and enabled outside production.
ENABLE_DOCS=false
AUDIT_RETENTION_DAYS=365
LOG_LEVEL=info
